# Jasmin Web Panel - Production Environment Configuration
# AWS EC2 Instance: 16.16.92.247

# Django Settings
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MINIMUM_50_CHARACTERS
DJANGO_SETTINGS_MODULE=config.settings.pro
ADMIN_URL=admin/
TIME_ZONE=Europe/Stockholm
LANGUAGE_CODE=en
SITE_ID=1

# Allowed Hosts (Add your domain if you have one)
ALLOWED_HOSTS=16.16.92.247,ec2-16-16-92-247.eu-north-1.compute.amazonaws.com,localhost
CSRF_TRUSTED_ORIGINS=http://16.16.92.247:8999,http://ec2-16-16-92-247.eu-north-1.compute.amazonaws.com:8999

# Database Configuration (PostgreSQL)
PRODB_URL=postgres://jasmin:CHANGE_THIS_DB_PASSWORD@db:5432/jasmin
POSTGRES_DB=jasmin
POSTGRES_USER=jasmin
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Jasmin Gateway Connection (Telnet)
TELNET_HOST=jasmin
TELNET_PORT=8990
TELNET_USERNAME=jcliadmin
TELNET_PW=jclipwd
TELNET_TIMEOUT=10

# Jasmin HTTP API
HTTP_HOST=http://jasmin
HTTP_PORT=1401
HTTP_USERNAME=foo
HTTP_PASSWORD=bar

# Jasmin SMPP
SMPP_HOST=jasmin
SMPP_PORT=2775
SMPP_SYSTEM_ID=foo
SMPP_PASSWORD=bar

# Submit Log Feature (Enable to track SMS messages)
SUBMIT_LOG=True

# API Rate Limiting
API_THROTTLE_ANON=20/minute
API_THROTTLE_USER=120/minute

# Port Configuration
JASMIN_WEB_PORT=8999
JASMIN_SMS_PORT=2775
JASMIN_DASHBOARD_PORT=8990
JASMIN_HTTP_API_PORT=1401

# RabbitMQ Configuration
AMQP_BROKER_HOST=rabbitmq
AMQP_BROKER_PORT=5672

# Database Logger Configuration
DB_TYPE_MYSQL=0
DB_HOST=db
DB_DATABASE=jasmin
DB_TABLE=submit_log
DB_USER=jasmin
DB_PASS=CHANGE_THIS_DB_PASSWORD

# Resource Limits (Optional)
REDIS_CPU=2
REDIS_MEM=512M
RABBITMQ_CPU=4
RABBITMQ_MEM=1024M
JASMIN_CPU=2
JASMIN_MEM=512M
